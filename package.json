{
  "name": "saucia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "cosmiconfig": "8.3.6"
    }
  },
  "scripts": {
    "dev": "turbo run dev --filter=@saucia/client",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "arch": "depcruise apps/customer-web/src apps/server/src packages --config .dependency-cruiser.cjs",
    "db:types": "supabase gen types typescript --local > packages/db-types/src/database.ts"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.4.0",
    "eslint": "^9.11.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "steiger": "^0.5.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^5.0.3"
  }
}
